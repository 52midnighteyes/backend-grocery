<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Created Successfully - GrocerGo</title>
  </head>
  <body style="margin:0;padding:0;background-color:rgb(245,247,244);font-family:Arial,sans-serif;color:rgb(20,29,22);line-height:1.5;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:rgb(245,247,244);padding:40px 20px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:rgb(255,255,255);border:1px solid rgb(214,224,216);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(20,29,22,0.06);">

            <!-- Header -->
            <tr>
              <td style="padding:28px 32px;background:linear-gradient(135deg,rgb(34,94,52),rgb(22,65,36));text-align:left;">
                <p style="margin:0;font-size:22px;font-weight:700;color:rgb(255,255,255);letter-spacing:-0.3px;">🛒 GrocerGo</p>
                <p style="margin:6px 0 0;font-size:13px;color:rgba(255,255,255,0.75);">Order Created Successfully</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;font-size:15px;">Hi, <strong>{{name}}</strong>!</p>
                <p style="margin:0 0 24px;font-size:15px;color:rgb(55,65,57);">Your order <strong>#{{orderId}}</strong> has been created successfully. Please complete your payment before the deadline.</p>

                <!-- Deadline Warning -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:24px;background-color:rgb(255,247,237);border:1px solid rgb(253,186,116);border-radius:10px;">
                  <tr>
                    <td style="padding:14px 18px;">
                      <p style="margin:0;font-size:13px;font-weight:700;color:rgb(154,52,18);">⏰ Payment Deadline</p>
                      <p style="margin:4px 0 0;font-size:14px;color:rgb(120,53,15);">{{paymentExpiredAt}}</p>
                      <p style="margin:4px 0 0;font-size:12px;color:rgb(154,52,18);">Your order will be automatically cancelled if payment is not received by then.</p>
                    </td>
                  </tr>
                </table>

                <!-- Order Items -->
                <p style="margin:0 0 10px;font-size:13px;font-weight:700;color:rgb(92,105,95);text-transform:uppercase;letter-spacing:0.5px;">Order Details</p>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:16px;border:1px solid rgb(214,224,216);border-radius:10px;overflow:hidden;">
                  {{#each items}}
                  <tr style="border-bottom:1px solid rgb(214,224,216);">
                    <td style="padding:12px 16px;">
                      <p style="margin:0;font-size:14px;font-weight:600;">{{name}}</p>
                      <p style="margin:2px 0 0;font-size:13px;color:rgb(92,105,95);">Qty: {{quantity}}</p>
                    </td>
                    <td style="padding:12px 16px;text-align:right;">
                      <p style="margin:0;font-size:14px;font-weight:600;">{{totalPrice}}</p>
                    </td>
                  </tr>
                  {{/each}}
                  <tr>
                    <td style="padding:12px 16px;background-color:rgb(245,247,244);">
                      <p style="margin:0;font-size:13px;color:rgb(92,105,95);">Shipping ({{shippingVendor}})</p>
                    </td>
                    <td style="padding:12px 16px;text-align:right;background-color:rgb(245,247,244);">
                      <p style="margin:0;font-size:13px;color:rgb(92,105,95);">{{deliveryFee}}</p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:12px 16px;background-color:rgb(240,245,241);">
                      <p style="margin:0;font-size:15px;font-weight:700;color:rgb(34,94,52);">Total</p>
                    </td>
                    <td style="padding:12px 16px;text-align:right;background-color:rgb(240,245,241);">
                      <p style="margin:0;font-size:15px;font-weight:700;color:rgb(34,94,52);">{{totalPrice}}</p>
                    </td>
                  </tr>
                </table>

                <!-- CTA -->
                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="border-radius:10px;background-color:rgb(34,94,52);">
                      <a href="{{orderUrl}}" style="display:inline-block;padding:12px 28px;font-size:14px;font-weight:700;color:rgb(255,255,255);text-decoration:none;border-radius:10px;">Pay Now</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:20px 32px;border-top:1px solid rgb(214,224,216);text-align:center;">
                <p style="margin:0;font-size:12px;color:rgb(92,105,95);">This email was sent automatically by GrocerGo. Please do not reply to this email.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
