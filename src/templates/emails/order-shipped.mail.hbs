<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pesanan Sedang Dikirim - GrocerGo</title>
  </head>
  <body style="margin:0;padding:0;background-color:rgb(245,247,244);font-family:Arial,sans-serif;color:rgb(20,29,22);line-height:1.5;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:rgb(245,247,244);padding:40px 20px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:rgb(255,255,255);border:1px solid rgb(214,224,216);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(20,29,22,0.06);">

            <!-- Header -->
            <tr>
              <td style="padding:28px 32px;background:linear-gradient(135deg,rgb(34,94,52),rgb(22,65,36));text-align:left;">
                <p style="margin:0;font-size:22px;font-weight:700;color:rgb(255,255,255);letter-spacing:-0.3px;">🛒 GrocerGo</p>
                <p style="margin:6px 0 0;font-size:13px;color:rgba(255,255,255,0.75);">Pesanan Sedang Dikirim</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;font-size:15px;">Hei, <strong>{{name}}</strong>!</p>
                <p style="margin:0 0 20px;font-size:15px;color:rgb(55,65,57);">Pesanan kamu dengan nomor <strong>#{{orderId}}</strong> sudah dalam perjalanan menuju alamatmu.</p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:24px;background-color:rgb(240,253,244);border:1px solid rgb(134,239,172);border-radius:10px;">
                  <tr>
                    <td style="padding:14px 18px;">
                      <p style="margin:0;font-size:13px;font-weight:700;color:rgb(21,128,61);">🚚 Info Pengiriman</p>
                      <p style="margin:6px 0 0;font-size:14px;color:rgb(20,83,45);">Kurir: <strong>{{shippingVendor}}</strong></p>
                      <p style="margin:6px 0 0;font-size:13px;color:rgb(20,83,45);">Setelah menerima pesanan, jangan lupa konfirmasi di aplikasi ya.</p>
                    </td>
                  </tr>
                </table>

                <!-- CTA -->
                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="border-radius:10px;background-color:rgb(34,94,52);">
                      <a href="{{orderUrl}}" style="display:inline-block;padding:12px 28px;font-size:14px;font-weight:700;color:rgb(255,255,255);text-decoration:none;border-radius:10px;">Konfirmasi Penerimaan</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:20px 32px;border-top:1px solid rgb(214,224,216);text-align:center;">
                <p style="margin:0;font-size:12px;color:rgb(92,105,95);">Email ini dikirim otomatis oleh GrocerGo. Jangan balas email ini.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
