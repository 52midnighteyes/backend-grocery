<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Cancelled - GrocerGo</title>
  </head>
  <body style="margin:0;padding:0;background-color:rgb(245,247,244);font-family:Arial,sans-serif;color:rgb(20,29,22);line-height:1.5;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:rgb(245,247,244);padding:40px 20px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:rgb(255,255,255);border:1px solid rgb(214,224,216);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(20,29,22,0.06);">

            <!-- Header -->
            <tr>
              <td style="padding:28px 32px;background:linear-gradient(135deg,rgb(185,28,28),rgb(127,15,15));text-align:left;">
                <p style="margin:0;font-size:22px;font-weight:700;color:rgb(255,255,255);letter-spacing:-0.3px;">🛒 GrocerGo</p>
                <p style="margin:6px 0 0;font-size:13px;color:rgba(255,255,255,0.75);">Order Cancelled</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;font-size:15px;">Hi, <strong>{{name}}</strong>!</p>
                <p style="margin:0 0 20px;font-size:15px;color:rgb(55,65,57);">We're sorry to inform you that your order <strong>#{{orderId}}</strong> has been cancelled by our team.</p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:24px;background-color:rgb(254,242,242);border:1px solid rgb(252,165,165);border-radius:10px;">
                  <tr>
                    <td style="padding:14px 18px;">
                      <p style="margin:0;font-size:13px;font-weight:700;color:rgb(153,27,27);">Cancellation Info</p>
                      <p style="margin:6px 0 0;font-size:14px;color:rgb(120,20,20);">If payment was already made, a refund will be processed outside the system. Please contact our team if you have any questions.</p>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 20px;font-size:14px;color:rgb(55,65,57);">We apologize for the inconvenience. You can place a new order anytime.</p>

                <!-- CTA -->
                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="border-radius:10px;background-color:rgb(34,94,52);">
                      <a href="{{shopUrl}}" style="display:inline-block;padding:12px 28px;font-size:14px;font-weight:700;color:rgb(255,255,255);text-decoration:none;border-radius:10px;">Shop Again</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:20px 32px;border-top:1px solid rgb(214,224,216);text-align:center;">
                <p style="margin:0;font-size:12px;color:rgb(92,105,95);">This email was sent automatically by GrocerGo. Please do not reply to this email.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
